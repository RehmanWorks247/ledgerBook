{
  "name": "ledgerbook",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "local": "npm run build:web && node --import tsx scripts/local.ts",
    "local:start": "npm run build:web && node scripts/local-control.cjs start",
    "local:stop": "node scripts/local-control.cjs stop",
    "local:status": "node scripts/local-control.cjs status",
    "email:test": "node --env-file-if-exists=.env --import tsx scripts/test-email.ts",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch scripts/dev-api.ts",
    "dev:web": "npm run dev --workspace @ledgerbook/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "build:operations": "tsc -p tsconfig.release.json",
    "release:preflight": "node --env-file=.env.production --import tsx scripts/release-preflight.ts",
    "release:monitor": "node --env-file=.env.production --import tsx scripts/release-monitor.ts",
    "test:release": "node --import tsx scripts/release-smoke.ts",
    "db:backup": "node --env-file-if-exists=.env.production --import tsx scripts/database-backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env.production --import tsx scripts/database-backup.ts restore",
    "build:web": "npm run build --workspace @ledgerbook/web",
    "start": "npm run local --",
    "stop": "node scripts/local-control.cjs stop",
    "status": "node scripts/local-control.cjs status",
    "start:api": "node --env-file-if-exists=.env dist/api/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @ledgerbook/web",
    "lint": "eslint apps tests scripts e2e playwright.config.ts",
    "test:e2e": "tsc --noEmit -p e2e/tsconfig.json && playwright test",
    "test": "node --env-file-if-exists=.env --require ./tests/test-environment.cjs --import tsx --test --test-concurrency=1 tests/*.test.ts && npm run test --workspace @ledgerbook/web",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/bootstrap.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "seed:demo": "node --import tsx scripts/seed-demo.ts",
    "db:cleanup": "node --env-file-if-exists=.env --import tsx scripts/cleanup.ts",
    "db:export:local": "node --import tsx scripts/export-local-database.ts",
    "storage:cleanup": "node --env-file-if-exists=.env --import tsx scripts/storage-cleanup.ts",
    "storage:backup": "node --env-file-if-exists=.env.production --import tsx scripts/document-backup.ts backup",
    "storage:restore": "node --env-file-if-exists=.env.production --import tsx scripts/document-backup.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/s3-request-presigner": "3.1163.0",
    "@clerk/backend": "^3.26.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pdfkit": "0.20.2",
    "pg": "^8.21.0",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "word-extractor": "1.0.4",
    "zod": "^4.0.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "minimatch": "11.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.1",
    "@electric-sql/pglite-tools": "0.3.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.25",
    "@types/multer": "2.3.0",
    "@types/node": "^25.9.1",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.0",
    "@types/word-extractor": "1.0.6",
    "eslint": "^10.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  }
}
