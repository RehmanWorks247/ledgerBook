{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "esModuleInterop": true, "experimentalDecorators": true,
    "emitDecoratorMetadata": true, "skipLibCheck": true, "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true, "types": ["node"], "noEmit": true, "jsx":"react-jsx"
  },
  "include": ["apps/api/src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
