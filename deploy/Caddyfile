{
  email {$ACME_EMAIL}
  admin off
}

{$PUBLIC_HOST} {
  encode zstd gzip
  # No access log: invitation URLs contain bearer tokens in their query strings.
  reverse_proxy app:3000 {
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    transport http {
      dial_timeout 5s
      response_header_timeout 60s
    }
  }
}
