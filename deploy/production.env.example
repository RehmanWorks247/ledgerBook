# Copy to private .env.production, chmod 600, and replace every placeholder.
NODE_ENV=production
PUBLIC_HOST=ledger.example.com
PUBLIC_APP_URL=https://ledger.example.com
ACME_EMAIL=operations@example.com
# UK business time for all users, including automatic GMT/BST changes.
BUSINESS_TIME_ZONE=Europe/London
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE
CLERK_SECRET_KEY=sk_live_REPLACE
DATABASE_URL=postgresql://ledgerbook_app:REPLACE@database.example.com/ledgerbook?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://ledgerbook_owner:REPLACE@database.example.com/ledgerbook?sslmode=verify-full
DATABASE_POOL_SIZE=10
DATABASE_SSL=true
EMAIL_MODE=resend
EMAIL_FROM="Umrah Packages Ltd <notifications@example.com>"
RESEND_API_KEY=re_REPLACE
RESEND_WEBHOOK_SECRET=whsec_REPLACE
DOCUMENT_STORAGE=r2
STORAGE_ENVIRONMENT=production
R2_ACCOUNT_ID=REPLACE
R2_DOCUMENT_BUCKET=ledgerbook-production
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
# REDIS_URL=rediss://default:REPLACE@redis.example.com:6379
