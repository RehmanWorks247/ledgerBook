NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
# Clerk manages invitations, passwords, recovery, and identity sessions.
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Real email works with this localhost origin. Use a Cloudflare HTTPS origin only
# for links opened on other devices or incoming delivery-status webhooks.
DATABASE_URL=postgresql://ledgerbook:local-only-change-me@localhost:5432/ledgerbook
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Use a direct (non-pooler) URL for migrations; defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/ledgerbook?sslmode=verify-full
# DATABASE_SSL_CA_FILE=/private/path/provider-ca.pem
# Local/offline tests can keep document bytes in Postgres. Use r2 for cloud uploads.
DOCUMENT_STORAGE=database
# Set DOCUMENT_STORAGE=r2 and configure a private bucket and bucket-scoped credentials.
# Development and production MUST use different buckets and credentials.
STORAGE_ENVIRONMENT=development
R2_ACCOUNT_ID=
R2_DOCUMENT_BUCKET=ledgerbook-documents-development
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Production deployment: NODE_ENV=production, STORAGE_ENVIRONMENT=production,
# R2_DOCUMENT_BUCKET=ledgerbook-documents-production, and production-only R2 keys.
# Never prefix R2 secrets with VITE_ or include them in browser configuration.
# Legacy S3 deployments remain supported with DOCUMENT_STORAGE=s3, AWS_REGION,
# S3_DOCUMENT_BUCKET and the AWS SDK server-side credential chain.
# Optional for the desktop launcher; recommended for shared server deployments.
REDIS_URL=redis://127.0.0.1:6379
EXCHANGE_RATE_URL=https://api.frankfurter.dev/v2/rates
EXCHANGE_RATE_TTL_SECONDS=3600
EXCHANGE_RATE_MAX_AGE_SECONDS=604800
# Booking/invoice, payment, reminder and legacy authentication email (Clerk handles its own auth email).
# Server deployments use these settings. dev:api prefers .local/email.env when present.
# The local launcher uses .local/email.env exclusively (file mode when absent).
# Test that local opt-in configuration with: npm run email:test -- --to you@example.com
# file writes private local mail; production payment delivery requires resend.
EMAIL_MODE=file
EMAIL_FROM="Umrah Packages Ltd <noreply@example.com>"
MAIL_DIRECTORY=.local/mail
RESEND_API_KEY=
# Resend dashboard webhook -> https://your-app.example/api/webhooks/resend
# Subscribe to email.sent/delivered/delivery_delayed/bounced/complained/failed/suppressed.
# Keep the whsec_ signing secret on the server; Settings reports when tracking is unconfigured.
RESEND_WEBHOOK_SECRET=
SESSION_TTL_SECONDS=43200
INVITATION_TTL_HOURS=72
# Explicit known proxy hop count only; default ignores spoofable forwarded addresses.
TRUST_PROXY_HOPS=0
# Business calendar for dashboard dates, instalments and departure entry.
BUSINESS_TIME_ZONE=UTC
# Optional: tests use PostgreSQL instead of embedded PostgreSQL engine.
# TEST_DATABASE_URL=postgresql://ledgerbook:local-only-change-me@localhost:5432/ledgerbook_test
