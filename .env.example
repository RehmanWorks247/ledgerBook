NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:5173
DATABASE_URL=postgresql://ledgerbook:local-only-change-me@localhost:5432/ledgerbook
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Use a direct (non-pooler) URL for migrations; defaults to DATABASE_URL.
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@DIRECT_HOST/ledgerbook?sslmode=verify-full
# DATABASE_SSL_CA_FILE=/private/path/provider-ca.pem
# Server-side document storage. Local development can keep bytea documents in Postgres.
# Production defaults to s3; explicit database mode remains available for compatibility.
DOCUMENT_STORAGE=database
# For S3, set DOCUMENT_STORAGE=s3 and supply the following. Use an IAM role in production.
AWS_REGION=
S3_DOCUMENT_BUCKET=
# AWS_ACCESS_KEY_ID=   # Only if an IAM role/profile is unavailable; never expose to the browser.
# AWS_SECRET_ACCESS_KEY=
# Optional for the desktop launcher; recommended for shared server deployments.
REDIS_URL=redis://127.0.0.1:6379
EXCHANGE_RATE_URL=https://api.frankfurter.dev/v2/rates
EXCHANGE_RATE_TTL_SECONDS=3600
EXCHANGE_RATE_MAX_AGE_SECONDS=604800
# resend is required in production. file writes private local mail without logging tokens.
EMAIL_MODE=file
EMAIL_FROM=LedgerBook <noreply@example.com>
MAIL_DIRECTORY=.local/mail
RESEND_API_KEY=
SESSION_TTL_SECONDS=43200
INVITATION_TTL_HOURS=72
# Explicit known proxy hop count only; default ignores spoofable forwarded addresses.
TRUST_PROXY_HOPS=0
# Business calendar for dashboard dates, instalments and departure entry.
BUSINESS_TIME_ZONE=UTC
# Optional: tests use PostgreSQL instead of embedded PostgreSQL engine.
# TEST_DATABASE_URL=postgresql://ledgerbook:local-only-change-me@localhost:5432/ledgerbook_test
