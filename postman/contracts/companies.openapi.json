{
  "openapi": "3.1.0",
  "info": {
    "title": "LedgerBook standalone companies",
    "version": "2.1.0",
    "description": "Company vouchers with informational room quantity and a separate company-wide paid amount. Voucher totals are summed across the entire company; balance is this sum minus company paid. Customer and hotel names are free text. No customer account, booking, ledger or notification records are created."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000/api",
      "description": "Replace with the configured application API origin."
    }
  ],
  "security": [
    {
      "sessionCookie": []
    },
    {
      "clerkBearer": []
    }
  ],
  "paths": {
    "/organizations/{orgId}/companies": {
      "parameters": [
        {
          "name": "orgId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "listCompanies",
        "summary": "List company customer records",
        "description": "Administrator only. Literal case-insensitive substring search and inclusive date filters apply to rows; ordering is creation time and ID descending. The totals object always covers every voucher in the selected company, ignoring search, dates and pagination. Company paid is stored separately; balance equals sum of full voucher prices minus company paid. Quantity is informational. If any voucher price is missing, total and balance remain null. Reads are limited to 240 per minute per user.",
        "responses": {
          "200": {
            "description": "Successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "409": {
            "description": "Stale version, changed idempotency input, or retry after deletion."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        },
        "parameters": [
          {
            "name": "company_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "Trimmed, case-insensitive exact company name. Scopes records and total before search, date filters and pagination; omitted returns the full workspace register. The admin UI uses Muhabiya Hotels, Aden Golden and Al Subaee."
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": ""
            },
            "description": ""
          },
          {
            "name": "date_field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "booking_date",
                "check_in",
                "check_out"
              ],
              "default": "booking_date"
            },
            "description": ""
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive lower date boundary, on or before end."
          },
          {
            "name": "end",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive upper date boundary."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            },
            "description": ""
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "description": ""
          }
        ]
      },
      "post": {
        "operationId": "createCompany",
        "summary": "Add a company voucher",
        "description": "Administrator only. A workspace-scoped UUID key retries the original committed result, including after edits. Different input or a deleted company with the same key returns 409. All writes share a limit of 240 per hour per user.",
        "parameters": [
          {
            "name": "X-CSRF-Protection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Must match the configured application origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompany"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "409": {
            "description": "Stale version, changed idempotency input, or retry after deletion."
          },
          "413": {
            "description": "JSON body exceeds 16 KB."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        }
      }
    },
    "/organizations/{orgId}/companies/{id}": {
      "parameters": [
        {
          "name": "orgId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "operationId": "updateCompany",
        "summary": "Edit voucher details",
        "description": "Administrator only. Send at least one field and the current version. Omitted fields are preserved; null clears dates or money. A changed row increments version; an identical edit keeps it. No money field is calculated from another. All writes share a limit of 240 per hour per user.",
        "parameters": [
          {
            "name": "X-CSRF-Protection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Must match the configured application origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCompany"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "409": {
            "description": "Stale version, changed idempotency input, or retry after deletion."
          },
          "413": {
            "description": "JSON body exceeds 16 KB."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        }
      },
      "delete": {
        "operationId": "deleteCompany",
        "summary": "Delete a voucher; preserve company paid",
        "description": "Administrator only. Requires current version. Deletes the row and clears its stored creation snapshot, retaining an opaque request receipt so delayed creation retries cannot recreate it. Workspace deletion removes receipts as well. All writes share a limit of 240 per hour per user.",
        "parameters": [
          {
            "name": "X-CSRF-Protection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Must match the configured application origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteCompany"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedCompany"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "409": {
            "description": "Stale version, changed idempotency input, or retry after deletion."
          },
          "413": {
            "description": "JSON body exceeds 16 KB."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        }
      }
    },
    "/organizations/{orgId}/companies/paid": {
      "parameters": [
        {
          "name": "orgId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "patch": {
        "operationId": "updateCompanyPaid",
        "summary": "Set the company-wide paid amount",
        "description": "Administrator only. Replaces the paid amount for all company vouchers together. Requires expected_version from totals.paid_version. Names are trimmed and matched case-insensitively. Zero clears paid. Stale edits return 409. An unchanged amount retains its version. Voucher creation, edits and deletion never change company paid. Requires CSRF headers and shares the 240/hour/user write limit.",
        "parameters": [
          {
            "name": "X-CSRF-Protection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "const": "1"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Must match the configured application origin."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCompanyPaid"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyPaid"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "409": {
            "description": "Stale version, changed idempotency input, or retry after deletion."
          },
          "413": {
            "description": "JSON body exceeds 16 KB."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        }
      }
    },
    "/organizations/{orgId}/companies/export": {
      "parameters": [
        {
          "name": "orgId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Read every voucher and shared totals for one company for Excel preview and download",
        "description": "Administrator only. Required company_name matches exactly and case-insensitively within this workspace. Returns all rows and company aggregates in one database snapshot, ordered by creation time and ID descending. No pagination or table filters are accepted. Currency is labeled SAR with unchanged stored amounts and precision. Uses the shared read rate limit.",
        "parameters": [
          {
            "name": "company_name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Complete company snapshot, including empty companies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyExport"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unknown field, unsupported precision, reversed stay dates or malformed date filter."
          },
          "401": {
            "description": "Authentication required."
          },
          "403": {
            "description": "Administrator access or valid CSRF headers required."
          },
          "404": {
            "description": "Workspace access is unavailable or company not found in this workspace."
          },
          "429": {
            "description": "Rate limit exceeded; retry after the Retry-After header."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "ledgerbook_session",
        "description": "Local authentication cookie; production uses __Host-ledgerbook."
      },
      "clerkBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Company": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "organization_id",
          "company_name",
          "hotel_name",
          "customer_name",
          "check_in",
          "check_out",
          "room_type",
          "booking_date",
          "voucher_number",
          "remarks",
          "voucher_price_minor",
          "version",
          "created_at",
          "updated_at",
          "quantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "company_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected.",
            "minLength": 1
          },
          "hotel_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "customer_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "check_in": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "check_out": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Must be on or after check_in when both are set."
          },
          "room_type": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "booking_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "voucher_number": {
            "type": "string",
            "maxLength": 100,
            "description": "Trimmed; null characters are rejected."
          },
          "remarks": {
            "type": "string",
            "maxLength": 2000,
            "description": "Trimmed; null characters are rejected."
          },
          "voucher_price_minor": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+$",
            "description": "Full voucher total in minor units. Quantity does not change it."
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1,
            "description": "Informational room quantity; does not multiply the voucher price."
          }
        }
      },
      "CreateCompany": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_name",
          "idempotency_key"
        ],
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected.",
            "minLength": 1
          },
          "hotel_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "customer_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "check_in": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "check_out": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Must be on or after check_in when both are set."
          },
          "room_type": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "booking_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "voucher_number": {
            "type": "string",
            "maxLength": 100,
            "description": "Trimmed; null characters are rejected."
          },
          "voucher_price": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 24,
            "pattern": "^\\d{1,18}(?:\\.\\d{1,3})?$",
            "description": "Full voucher total in workspace currency as decimal text; quantity is informational and never multiplies this value. Null if unknown. Up to 100000000000000 minor units; zero is allowed."
          },
          "remarks": {
            "type": "string",
            "maxLength": 2000,
            "description": "Trimmed; null characters are rejected."
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          }
        }
      },
      "UpdateCompany": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "minProperties": 2,
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected.",
            "minLength": 1
          },
          "hotel_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "customer_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "check_in": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "check_out": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Must be on or after check_in when both are set."
          },
          "room_type": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected."
          },
          "booking_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Calendar date from 1900-01-01 through 9999-12-31, or null."
          },
          "voucher_number": {
            "type": "string",
            "maxLength": 100,
            "description": "Trimmed; null characters are rejected."
          },
          "voucher_price": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 24,
            "pattern": "^\\d{1,18}(?:\\.\\d{1,3})?$",
            "description": "Full voucher total in workspace currency as decimal text; quantity is informational and never multiplies this value. Null if unknown. Up to 100000000000000 minor units; zero is allowed."
          },
          "remarks": {
            "type": "string",
            "maxLength": 2000,
            "description": "Trimmed; null characters are rejected."
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000,
            "default": 1
          }
        }
      },
      "DeleteCompany": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483646
          }
        }
      },
      "CompanyPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "currency",
          "currency_exponent",
          "totals"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "currency": {
            "type": "string"
          },
          "currency_exponent": {
            "type": "integer",
            "enum": [
              0,
              2,
              3
            ]
          },
          "totals": {
            "$ref": "#/components/schemas/VoucherTotals"
          }
        }
      },
      "DeletedCompany": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "deleted": {
            "const": true
          }
        }
      },
      "VoucherTotals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total_minor",
          "paid_minor",
          "balance_minor",
          "unpriced_count",
          "unpaid_minor",
          "voucher_count",
          "paid_version"
        ],
        "properties": {
          "total_minor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sum of all full voucher prices for the selected company, ignoring table search, dates and pagination. Null if any voucher price is unknown. Quantity does not multiply price."
          },
          "paid_minor": {
            "type": "string",
            "description": "Independently entered company-wide paid amount; never derived from individual voucher rows."
          },
          "balance_minor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Sum of all company voucher prices minus company paid, or null when a price is unknown. Negative means credit."
          },
          "unpriced_count": {
            "type": "integer",
            "minimum": 0
          },
          "unpaid_minor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Maximum of company balance and zero; null when a price is unknown."
          },
          "voucher_count": {
            "type": "integer",
            "minimum": 0,
            "description": "All vouchers for the company, ignoring table filters."
          },
          "paid_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Version required when updating company paid; zero for a company without a saved paid amount, null for an unfiltered multi-company listing."
          }
        }
      },
      "UpdateCompanyPaid": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_name",
          "paid",
          "expected_version"
        ],
        "properties": {
          "company_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Trimmed; null characters are rejected.",
            "minLength": 1
          },
          "paid": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[0-9]{1,27}(?:\\.[0-9]{1,3})?$",
            "description": "Nonnegative total paid to date in workspace currency. Decimal precision follows currency_exponent. Replaces the company paid amount; not an incremental payment."
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          }
        }
      },
      "CompanyPaid": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company_name",
          "paid_minor",
          "version"
        ],
        "properties": {
          "company_name": {
            "type": "string"
          },
          "paid_minor": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CompanyExport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "total",
          "currency",
          "currency_exponent",
          "totals",
          "company_name"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "const": "SAR",
            "description": "Export label only; no currency conversion."
          },
          "currency_exponent": {
            "type": "integer",
            "enum": [
              0,
              2,
              3
            ]
          },
          "totals": {
            "$ref": "#/components/schemas/VoucherTotals"
          },
          "company_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
